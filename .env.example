# Copy to .env and fill in. Never commit a real .env.
PORT=8787
# Admin + observer auth (set both before exposing beyond localhost)
ADMIN_TOKEN=
OBSERVER_SECRET=
# WhatsApp Cloud API — leave blank for local demo mode (code shown on screen)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_code
